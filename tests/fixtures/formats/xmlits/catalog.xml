<?xml version="1.0" encoding="UTF-8"?>
<catalog xmlns:its="http://www.w3.org/2005/11/its" its:version="2.0">
  <its:rules version="2.0">
    <its:translateRule selector="//product/@label" translate="yes"/>
    <its:translateRule selector="//sku" translate="no"/>
    <its:withinTextRule selector="//b | //br" withinText="yes"/>
