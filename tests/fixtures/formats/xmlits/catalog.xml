      <its:locNote>Max 80 characters.</its:locNote>
    </its:locNoteRule>
  </its:rules>
  <product label="Desk lamp" code="L-1">
    <sku>L-100-BLK</sku>
    <desc>A <b>bright</b> lamp<br/>for your desk.</desc>
    <legal its:translate="no">Made in EU</legal>
    <verbatim xml:space="preserve">Line one
    indented   line</verbatim>
  </product>
</catalog>
