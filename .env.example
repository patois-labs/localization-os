# Localization OS environment file.
# Copy this file to ".env" in the repository root. Every line is optional: with no
# .env at all the app starts on http://127.0.0.1:8000 with SQLite in ./data/.
# Anything you can set here can also be set as a real environment variable, which
# wins over this file. Most settings can also be changed later in the web UI
# (Settings, Setup AI) or with the CLI (`loc-tms config set <key> <value>`).

# ---------------------------------------------------------------------------
# 1. Translation engine
# ---------------------------------------------------------------------------
# Which engine translates by default: mock, claude, gemini, openai or local.
# "mock" is a free, offline, deterministic engine (output looks like "[es] Hello")
# so you can try every feature without an API key. Switch to a real engine once
# you have added its key below. A real engine with no key fails loudly instead of
# quietly producing mock text.
DEFAULT_PROVIDER=mock

# Cloud provider keys. Leave blank the ones you do not use.
# Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Default model per provider (these are the built-in defaults).
DEFAULT_CLAUDE_MODEL=claude-haiku-4-5
DEFAULT_GEMINI_MODEL=gemini-3.6-flash
DEFAULT_OPENAI_MODEL=gpt-4o-mini

# Optional backup engine used when the project's engine errors (blank = none).
DEFAULT_FALLBACK_PROVIDER=

# Local or self-hosted engine (LM Studio, Ollama, vLLM, llama.cpp): any server that
# speaks the OpenAI chat API. With DEFAULT_PROVIDER=local no text leaves your
# network. "/v1" is added automatically. Example: http://127.0.0.1:1234
LOCAL_BASE_URL=
# Most local servers ignore the key but the client needs a non-empty value.
LOCAL_API_KEY=lm-studio
DEFAULT_LOCAL_MODEL=

# Optional hosted Jev quality-estimation judge (TypeSafe), used only by workflow
# steps that select it. Leave the key blank to keep it off.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_QE_MEANING_FLOOR=0.8

# ---------------------------------------------------------------------------
# 2. Server and storage
# ---------------------------------------------------------------------------
# Address and port for `python run.py`. On 127.0.0.1 a fresh install seeds local
# development accounts (admin/admin, asked to change on first sign-in). Any other
# address, or the container, seeds nothing and opens the /auth/setup wizard.
HOST=127.0.0.1
PORT=8000

# Where the database, uploads and generated keys live (default: ./data).
# LOC_TMS_DATA_DIR=

# Postgres instead of SQLite (needs `pip install -r requirements-postgres.txt`,
# then `alembic upgrade head`). Blank = SQLite in the data folder.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/localization_os

# Logging: LOG_LEVEL (DEBUG, INFO, WARNING) and LOG_FORMAT (text or json).
# LOG_LEVEL=INFO
# LOG_FORMAT=text

# ---------------------------------------------------------------------------
# 3. Secrets (generated for you)
# ---------------------------------------------------------------------------
# The cookie-signing secret and the key that encrypts stored API tokens are
# generated on first start and kept in the data folder (.session_secret, .enc_key).
# Set them here only when the data folder is not persistent (containers) or you
# manage secrets elsewhere. Back them up: losing the encryption key makes stored
# connector tokens unreadable. Session secret: at least 16 characters.
# See docs/SECRETS.md.
# LOC_TMS_SESSION_SECRET=
# LOC_TMS_ENCRYPTION_KEY=

# One-time token for the /auth/setup wizard on a server install. Blank = one is
# generated into the data folder (.setup_token) and printed in the log.
# LOC_TMS_SETUP_TOKEN=

# ---------------------------------------------------------------------------
# 4. Running behind a proxy or on a network (see docs/DEPLOY.md)
# ---------------------------------------------------------------------------
# The public https address users reach, for example https://tms.example.com.
# Here it only switches session cookies to Secure; the address used in links and
# callbacks is the "app_base_url" setting (Settings, or `loc-tms config set`).
# LOC_TMS_PUBLIC_BASE_URL=
# Secure cookies: auto (default: on when LOC_TMS_PUBLIC_BASE_URL is https), 1 or 0.
# LOC_TMS_SECURE_COOKIES=auto
# Host names and addresses this install answers to, comma separated. Overrides the
# Security page value. See docs/LOCAL-INSTALL-SECURITY.md.
# LOC_TMS_SECURITY_ALLOWED_HOSTS=
# Exact addresses of your reverse proxy (/32 or /128 each). Only these may set
# X-Forwarded-For. Never list a whole private range.
# LOC_TMS_TRUSTED_PROXY_IPS=

# ---------------------------------------------------------------------------
# 5. Optional: reach a model server over Tailscale from a container
# ---------------------------------------------------------------------------
# When set, the container starts a userspace Tailscale client and sends only
# tailnet-bound engine calls (100.64.0.0/10 or *.ts.net) through it. Use a
# reusable, ephemeral auth key. Blank = no Tailscale at all.
# TS_AUTHKEY=
# Override the SOCKS5 proxy (default socks5://localhost:1055 when TS_AUTHKEY is set).
# LOC_TMS_TAILNET_PROXY=

# ---------------------------------------------------------------------------
# 6. Capacity (defaults suit one small server; see docs/architecture/configuration.md)
# ---------------------------------------------------------------------------
# A blank or malformed value falls back to the default with a warning.
# Background job workers.
# LOC_TMS_JOB_WORKERS=2
# Workflow runs this process executes at once (0 = no limit). Extra launches get a
# retryable 503; wide batches queue instead.
# LOC_TMS_MAX_CONCURRENT_RUNS=8
# Database connection pool. Each running workflow holds connections, so size +
# overflow must comfortably exceed the run limit.
# LOC_TMS_DB_POOL_SIZE=20
# LOC_TMS_DB_MAX_OVERFLOW=40
# LOC_TMS_DB_POOL_TIMEOUT_S=5.0
# LOC_TMS_DB_REQUEST_HEADROOM=10
# SQLite page cache per connection, in KiB (memory use = pool size x this).
# LOC_TMS_SQLITE_CACHE_KB=1000
# How long /ready waits for the database; keep it under your health-check timeout.
# LOC_TMS_READY_PROBE_TIMEOUT_S=2.0
# Cache lifetime for engine settings edited by another process (0 = no cache).
# LOC_TMS_ENGINE_PROFILE_CACHE_TTL_S=5.0

# Upload and parsing limits (MAX_UPLOAD_BYTES, MAX_DOCUMENT_SEGMENTS, ZIP_*, XLSX_*,
# PDF_*, and others) and per-provider rate limits (TPS_*) are listed with their
# defaults in docs/architecture/configuration.md.

# ---------------------------------------------------------------------------
# Not for real installs
# ---------------------------------------------------------------------------
# The test suites set LOC_TMS_TEST_MODE, LOC_TMS_MOCK_FALLBACK and related
# variables themselves. Do not set them here: LOC_TMS_MOCK_FALLBACK=1 makes a
# keyless engine silently return mock text.
